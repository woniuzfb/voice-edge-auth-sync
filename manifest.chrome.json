{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "cookies",
    "tabs",
    "notifications",
    "nativeMessaging",
    "webRequest",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.doubao.com/*",
    "https://*.doubao.com/*",
    "https://chat.qwen.ai/*",
    "https://*.qwen.ai/*",
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*",
    "https://login.microsoftonline.com/*",
    "https://substrate.office.com/*",
    "https://outlook.cloud.microsoft/*",
    "https://outlook.office.com/*",
    "https://m365copilotapp.svc.cloud.microsoft/*",
    "https://m365.cloud.microsoft/*",
    "https://*.sharepoint.com/*",
    "https://aistudio.google.com/*",
    "https://alkalimakersuite-pa.clients6.google.com/*",
    "https://alkalimakersuiteapplets.pa.clients6.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.doubao.com/*"],
      "js": ["browser-polyfill.js", "content-doubao.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["browser-polyfill.js", "content-deepseek.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.cloud.microsoft/*",
        "https://m365.cloud.microsoft/*",
        "https://outlook.office.com/*",
        "https://m365copilotapp.svc.cloud.microsoft/*"
      ],
      "js": ["browser-polyfill.js", "content-m365.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://*.sharepoint.com/sites/*"],
      "js": ["browser-polyfill.js", "content-sharepoint.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://login.microsoftonline.com/*"],
      "js": ["browser-polyfill.js", "content-m365-login.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["browser-polyfill.js", "content-aistudio.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Voice Edge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
