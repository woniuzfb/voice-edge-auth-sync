{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "voice-edge-auth-sync@local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "cookies",
    "tabs",
    "notifications",
    "nativeMessaging",
    "webRequest",
    "webRequestBlocking",
    "https://www.doubao.com/*",
    "https://*.doubao.com/*",
    "https://chat.qwen.ai/*",
    "https://*.qwen.ai/*",
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*",
    "storage",
    "https://login.microsoftonline.com/*",
    "https://substrate.office.com/*",
    "https://outlook.cloud.microsoft/*",
    "https://outlook.office.com/*",
    "https://m365copilotapp.svc.cloud.microsoft/*",
    "https://m365.cloud.microsoft/*",
    "https://*.sharepoint.com/*",
    "https://aistudio.google.com/*",
    "https://alkalimakersuite-pa.clients6.google.com/*"
  ],
  "background": {
    "scripts": ["browser-polyfill.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["browser-polyfill.js", "content-deepseek.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.cloud.microsoft/*",
        "https://m365.cloud.microsoft/*",
        "https://outlook.office.com/*",
        "https://m365copilotapp.svc.cloud.microsoft/*"
      ],
      "js": ["browser-polyfill.js", "content-m365.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://*.sharepoint.com/sites/*"],
      "js": ["browser-polyfill.js", "content-sharepoint.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://login.microsoftonline.com/*"],
      "js": ["browser-polyfill.js", "content-m365-login.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["browser-polyfill.js", "content-aistudio.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_title": "Voice Edge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
